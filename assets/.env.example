# Copy this file to `assets/.env` and fill in both values.
# `assets/.env` is gitignored and must never be committed.
#
# Both values come from the Supabase dashboard:
#   Settings -> Data API  -> API URL
#   Settings -> API Keys  -> Publishable key
#
# SUPABASE_URL is the project origin ONLY — no path, no trailing slash. The
# dashboard displays it as `https://<project-ref>.supabase.co/rest/v1/`; drop
# the `/rest/v1/` part. The SDK appends `/auth/v1`, `/rest/v1` and
# `/storage/v1` itself, so leaving the path on gives a 404 "invalid path
# specified in request url" at login.
#
# Only the publishable key belongs in this file. It is a client-side key: it
# ships inside the APK by design and carries the same low privileges as the old
# `anon` key, so RLS still decides what the caller may actually read and write.
#
# The secret key (`sb_secret_...`) is server-side only. It must never appear
# here, in the repo, or in the app bundle — that was the original prototype's
# critical vulnerability (see docs/ASSESSMENT.md). It belongs in Supabase Edge
# Function secrets, starting in Phase 5.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<rest-of-key>

# PowerSync instance endpoint. In the PowerSync dashboard: right-click the
# instance -> Edit instance -> Copy Instance URL.
POWERSYNC_URL=https://<instance-id>.powersync.journeyapps.com
